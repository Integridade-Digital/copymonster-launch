{
  "name": "@deepseek-ai/dsh-api-auth-http",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "CopyMonster HTTP auth and billing routes registered on the DSH webserver",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./billing": {
      "types": "./lib/types/billing.d.ts",
      "default": "./lib/billing.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/billing.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.js"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-auth-context": "workspace:*",
    "@deepseek-ai/dsh-constants": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-supabase-client": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-connection": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}

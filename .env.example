# Variáveis de Ambiente do CopyMonster

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Obtenha estas chaves em: https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# FRONTEND (VITE)
# ============================================
# Prefixo VITE_ é necessário para variáveis expostas ao browser

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# SERVER CONFIGURATION
# ============================================

PORT=3000
NODE_ENV=development

# ============================================
# CLOUDFLARE TUNNEL (opcional)
# ============================================
# Configurar após deploy no VPS

CLOUDFLARE_TUNNEL_ID=your-tunnel-id
CLOUDFLARE_API_TOKEN=your-api-token

# ============================================
# STRIPE (Fase 5 - Monetização)
# ============================================
# Deixar em branco até a Fase 5

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# INSTRUÇÕES DE SETUP
# ============================================
# 1. Copie este arquivo para .env.local
# 2. Preencha com suas credenciais do Supabase
# 3. NUNCA commitar .env.local no git
# 4. Para produção, configurar variáveis no servidor

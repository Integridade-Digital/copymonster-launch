{
  "name": "@deepseek-ai/dsh-constants",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Shared CopyMonster constants (default tenant, auth context names)",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",

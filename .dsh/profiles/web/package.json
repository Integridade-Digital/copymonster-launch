    "dshmarket": "^1.73.1"
  },
  "scripts": {
    "postinstall": "node ../../../../copymonster-launch/scripts/apply-dsh-im-rebrand.mjs && node ../../../../copymonster-launch/scripts/apply-dshmarket-rebrand.mjs && node ../../../../copymonster-launch/scripts/apply-dsh-plugins-rebrand.mjs"

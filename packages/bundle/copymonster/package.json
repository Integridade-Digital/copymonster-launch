{
  "name": "@deepseek-ai/dsh-copymonster",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "CopyMonster SaaS layer: mounts the auth service and HTTP auth routes over the shipped web profile",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-auth-context": "workspace:*",
    "@deepseek-ai/dsh-api-auth-http": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "typescript": "^6.0.3"
  }
}

{
  "name": "@deepseek-ai/dsh-host-brand-assets",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "CopyMonster brand image routes: serves the SPA dist logos with the right media type and revalidating cache headers",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-web-frontend": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3",
    "vitest": "^1.0.0"
  }
}
